# Local LLM served by Ollama (https://ollama.com) - free, runs on your
# machine, no API key needed. Install Ollama, run `ollama pull llama3.2:3b`
# once, then leave Ollama running (or let it auto-start) before using the app.
OLLAMA_MODEL=llama3.2:3b

# Only needed if your Ollama server isn't the local default.
# OLLAMA_HOST=http://localhost:11434
